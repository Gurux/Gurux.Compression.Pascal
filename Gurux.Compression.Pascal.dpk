/// Delphi runtime package. Core units depend only on the RTL; no GUI packages.
package GuruxCompressionPascal;

requires
  rtl;

contains
  Gurux.Compression.Types in 'Source\Gurux.Compression.Types.pas',
  Gurux.Compression.Options in 'Source\Gurux.Compression.Options.pas',
  Gurux.Compression.Bits in 'Source\Gurux.Compression.Bits.pas',
  Gurux.Compression.Encoder in 'Source\Gurux.Compression.Encoder.pas',
  Gurux.Compression.Decoder in 'Source\Gurux.Compression.Decoder.pas';

end.
